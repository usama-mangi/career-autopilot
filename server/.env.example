# All values in this file are placeholders. Copy to .env and fill in real values.
# .env is gitignored; never commit real keys.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_analyzer

# Better Auth
BETTER_AUTH_SECRET=this-is-the-worse-auth-key-32-chars
BETTER_AUTH_SERVER_URL=http://localhost:3000/api/auth
BETTER_AUTH_CLIENT_URL=http://localhost:5173

# OpenAI / LLM
OPENAI_API_KEY=sk-your-openai-compatible-api-key
OPENAI_BASE_URL=https://api.llm7.io/v1
OPENAI_MODEL=codestral-latest

# File Upload
UPLOAD_DIR=./uploads

# Job Board Aggregation (JSearch API via RapidAPI)
# Get your key at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=your-rapidapi-jsearch-key
JSEARCH_API_HOST=jsearch.p.rapidapi.com

# Redis (for caching, rate limiting, and job queues)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password  # if using auth
